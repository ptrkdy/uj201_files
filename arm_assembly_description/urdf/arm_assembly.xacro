  </visual>
  <collision>
    <origin xyz="-0.056173 -0.00865 -0.022" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find arm_assembly_description)/meshes/p02_new_base_neck_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

