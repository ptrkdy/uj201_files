<?xml version="1.0" ?>
<robot name="arm_assembly" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find arm_assembly_description)/urdf/materials.xacro" />
<xacro:include filename="$(find arm_assembly_description)/urdf/arm_assembly.ros2control" />
<xacro:include filename="$(find arm_assembly_description)/urdf/arm_assembly.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0.029562448087113703 0.008999790502759704 0.01714890804924539" rpy="0 0 0"/>
    <mass value="0.910245859615558"/>
    <inertia ixx="0.000946" iyy="0.000846" izz="0.00097" ixy="0.0" iyz="0.0" ixz="0.000159"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find arm_assembly_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find arm_assembly_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

