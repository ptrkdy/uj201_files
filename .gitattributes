# Shell scripts must keep LF endings: bash fails obscurely on CRLF ("\r: command not found").
*.sh text eol=lf

# Meshes are binary; never let newline conversion near them.
*.stl binary

# CAD and print artefacts are binary. Git would otherwise try to diff and
# merge them, and newline conversion would corrupt them outright.
*.f3z binary
*.f3d binary
*.step binary
*.stp binary
*.3mf binary
